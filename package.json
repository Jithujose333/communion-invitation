{
  "name": "wedding-invitation-root",
  "version": "1.0.0",
  "description": "Wedding Invitation MERN Application Root",
  "scripts": {
    "backend": "node backend/server.js",
    "frontend": "node frontend/node_modules/vite/bin/vite.js frontend",
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js \"node backend/server.js\" \"node frontend/node_modules/vite/bin/vite.js frontend\"",
    "build": "npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend",
    "start": "node backend/server.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
